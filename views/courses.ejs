<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shield Academy - All Courses</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #060913;
            --card-bg: rgba(17, 24, 39, 0.75);
            --primary-neon: #00ffcc;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --border-color: rgba(31, 41, 55, 0.7);
            --danger-neon: #ff3333;
            --admin-neon: #ff3366;
        }

        #matrix-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: -1; 
            pointer-events: none;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* =======================================================
           🛡️ BRAND NAVBAR LOGO & NEON GLITCH ENGINE
           ======================================================= */
        header {
            background-color: rgba(17, 24, 39, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar-brand-node {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: default;
            user-select: none;
            text-decoration: none;
        }

        .nav-animated-shield {
            position: relative;
            width: 35px;
            height: 38px;
            background: transparent;
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            border: 1.5px solid #00ffcc;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
            animation: navShieldPulse 3s infinite ease-in-out;
        }

        .nav-animated-shield::before {
            content: "🛡️";
            font-size: 16px;
        }

        .nav-brand-name {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.6);
            margin: 0;
            animation: navNeonGlitch 4s infinite alternate;
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            margin: 0;
            padding: 0;
            align-items: center;
        }

        .nav-menu a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-menu a:hover, .nav-menu a.active {
            color: var(--primary-neon);
        }

        .admin-btn {
            background: transparent;
            border: 1px solid var(--admin-neon);
            color: var(--admin-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease-in-out;
        }

        .admin-btn:hover {
            background-color: var(--admin-neon);
            color: #000000;
            box-shadow: 0 0 15px rgba(255, 51, 102, 0.6);
            transform: translateY(-2px);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 14px;
        }

        .logout-btn {
            background: transparent;
            border: 1px solid var(--danger-neon);
            color: var(--danger-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: var(--danger-neon);
            color: var(--text-main);
        }

        @keyframes navShieldPulse {
            0% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
            50% { transform: scale(1.05); box-shadow: 0 0 18px rgba(255, 0, 85, 0.6); border-color: #ff0055; }
            100% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
        }

        @keyframes navNeonGlitch {
            0%, 95%, 100% { text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 0 15px rgba(0, 255, 204, 0.3); color: #fff; }
            96% { text-shadow: -2px -1px 0 #ff0055, 2px 1px 0 #00ffcc; color: #ff0055; }
            98% { text-shadow: 2px 1px 0 #ff0055, -2px -1px 0 #00ffcc; color: #00ffcc; }
        }

        /* =======================================================
           📦 COURSES CARD GRID LAYER
           ======================================================= */
        main {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
            text-align: center;
        }

        h1 {
            color: var(--primary-neon);
            font-size: 32px;
            margin-bottom: 5px;
        }

        .student-badge {
            color: var(--text-muted);
            font-size: 15px;
            margin-bottom: 40px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            text-align: left;
        }

        .card {
            background-color: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
            transition: transform 0.2s, border-color 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-neon);
        }

        .card-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-bottom: 1px solid var(--border-color);
        }

        .card-content {
            padding: 20px;
        }

        .card-content h3 {
            margin: 0 0 10px 0;
            font-size: 18px;
            color: var(--text-main);
        }

        .card-content p {
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 15px;
            height: 40px;
            overflow: hidden;
        }

        .price-tag {
            font-size: 18px;
            font-weight: bold;
            color: var(--primary-neon);
        }

        .back-btn {
            display: inline-block;
            margin-top: 50px;
            margin-bottom: 40px;
            color: var(--primary-neon);
            text-decoration: none;
            border: 1px solid var(--primary-neon);
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: bold;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .back-btn:hover {
            background: var(--primary-neon);
            color: #000;
            box-shadow: 0 0 15px var(--primary-neon);
        }
    </style>
</head>
<body>

    <canvas id="matrix-bg"></canvas>

    <header>
        <div class="navbar">
            <div class="navbar-brand-node">
                <div class="nav-animated-shield"></div>
                <span class="nav-brand-name">Shield Academy</span>
            </div>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/courses" class="active">Courses</a></li>
                <li><a href="/dashboard">My Dashboard</a></li>
                <li><a href="/about">About</a></li>
                <% if (user && user.role === 'admin') { %>
                    <li>
                        <a href="/admin/dashboard" class="admin-btn">
                            <i class="fa-solid fa-user-shield"></i> Admin Panel
                        </a>
                    </li>
                <% } %>
            </ul>
            <div class="user-profile">
                <span>Welcome, <b style="color: var(--primary-neon);"><%= user.name %></b></span>
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </div>
    </header>

    <main>
        <h1>📚 All Cybersecurity Curriculum</h1>
        <div class="student-badge">Logged in as: <b style="color: var(--primary-neon);"><%= user.name %></b></div>

        <div class="grid">
            <% courses.forEach(function(course) { %>
                <div class="card">
                    <img src="<%= course.image %>" class="card-img" alt="<%= course.name %>">
                    <div class="card-content">
                        <h3><%= course.name %></h3>
                        <p><%= course.desc %></p>
                        <div class="price-tag">Rs. <%= course.price %></div>
                    </div>
                </div>
            <% }); %>
        </div>

        <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>
    </main>

<script>
const canvas = document.getElementById('matrix-bg');
const ctx = canvas.getContext('2d');
let particlesArray = [];
const numParticles = 85; 
const maxConnectDistance = 120;
let mouse = { x: null, y: null, radius: 160 };

window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mouseout', () => { mouse.x = null; mouse.y = null; });
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resizeCanvas(); window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.7; 
        this.vy = (Math.random() - 0.5) * 0.7;
        this.radius = Math.random() * 2.5 + 1;
    }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
        ctx.fillStyle = 'rgba(255, 0, 85, 0.7)'; ctx.fill();
    }
    update() {
        if (this.x < 0 || this.x > canvas.width) this.vx = -this.vx;
        if (this.y < 0 || this.y > canvas.height) this.vy = -this.vy;
        let dx = mouse.x - this.x; let dy = mouse.y - this.y; let dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < mouse.radius && mouse.x !== null) {
            this.x += (dx / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
            this.y += (dy / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
        }
        this.x += this.vx; this.y += this.vy;
    }
}
function initParticles() { for(let i=0; i<numParticles; i++) particlesArray.push(new Particle()); }
function connectNodes() {
    for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a + 1; b < particlesArray.length; b++) {
            let dx = particlesArray[a].x - particlesArray[b].x; let dy = particlesArray[a].y - particlesArray[b].y;
            let dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < maxConnectDistance) {
                ctx.strokeStyle = `rgba(255, 0, 85, ${(1 - (dist / maxConnectDistance)) * 0.18})`;
                ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(particlesArray[a].x, particlesArray[a].y); ctx.lineTo(particlesArray[b].x, particlesArray[b].y); ctx.stroke();
            }
        }
    }
}
function animateParticles() { ctx.clearRect(0, 0, canvas.width, canvas.height); for(let i=0; i<particlesArray.length; i++) { particlesArray[i].update(); particlesArray[i].draw(); } connectNodes(); requestAnimationFrame(animateParticles); }
initParticles(); animateParticles();
</script>
</body>
</html>