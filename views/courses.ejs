<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shield Academy - All Courses</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #111827;
            --primary-neon: #00ffcc;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --border-color: #1f2937;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 40px 20px;
            text-align: center;
        }

        h1 {
            color: var(--primary-neon);
            font-size: 32px;
            margin-bottom: 5px;
        }

        .student-badge {
            color: var(--text-muted);
            font-size: 15px;
            margin-bottom: 40px;
        }

        /* 📦 COURSES CARD GRID LAYER */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
            text-align: left;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
            transition: transform 0.2s, border-color 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-neon);
        }

        .card-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-bottom: 1px solid var(--border-color);
        }

        .card-content {
            padding: 20px;
        }

        .card-content h3 {
            margin: 0 0 10px 0;
            font-size: 18px;
            color: var(--text-main);
        }

        .card-content p {
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 15px;
            height: 40px;
            overflow: hidden;
        }

        .price-tag {
            font-size: 18px;
            font-weight: bold;
            color: var(--primary-neon);
        }

        /* ↩️ BACK BUTTON STYLE */
        .back-btn {
            display: inline-block;
            margin-top: 50px;
            color: var(--primary-neon);
            text-decoration: none;
            border: 1px solid var(--primary-neon);
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .back-btn:hover {
            background: var(--primary-neon);
            color: #000;
            box-shadow: 0 0 15px var(--primary-neon);
        }
    </style>
</head>
<body>

    <h1>📚 All Cybersecurity Curriculum</h1>
    <div class="student-badge">Logged in as: <b style="color: var(--primary-neon);"><%= user.name %></b></div>

    <!-- 🌐 LIVE IMAGE CARD GRID LINKED WITH DATABASE MONGO FRAMEWORK -->
    <div class="grid">
        <% courses.forEach(function(course) { %>
            <div class="card">
                <!-- 🖼️ Dynamic Image Loading Box -->
                <img src="<%= course.image %>" class="card-img" alt="<%= course.name %>">
                
                <div class="card-content">
                    <h3><%= course.name %></h3>
                    <p><%= course.desc %></p>
                    <div class="price-tag">Rs. <%= course.price %></div>
                </div>
            </div>
        <% }); %>
    </div>

    <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>

</body>
</html>