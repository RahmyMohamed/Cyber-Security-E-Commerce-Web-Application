<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shield Academy - Student Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #060913;
            --card-bg: rgba(17, 24, 39, 0.75);
            --primary-neon: #00ffcc;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --border-color: rgba(31, 41, 55, 0.7);
            --danger-neon: #ff3333;
            --admin-neon: #ff3366;
        }

        #matrix-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: -1; 
            pointer-events: none;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* =======================================================
           🛡️ BRAND NAVBAR LOGO & NEON GLITCH ENGINE
           ======================================================= */
        header {
            background-color: rgba(17, 24, 39, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar-brand-node {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: default;
            user-select: none;
            text-decoration: none;
        }

        .nav-animated-shield {
            position: relative;
            width: 35px;
            height: 38px;
            background: transparent;
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            border: 1.5px solid #00ffcc;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
            animation: navShieldPulse 3s infinite ease-in-out;
        }

        .nav-animated-shield::before {
            content: "🛡️";
            font-size: 16px;
        }

        .nav-brand-name {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.6);
            margin: 0;
            animation: navNeonGlitch 4s infinite alternate;
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            margin: 0;
            padding: 0;
            align-items: center;
        }

        .nav-menu a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-menu a:hover, .nav-menu a.active {
            color: var(--primary-neon);
        }

        .admin-btn {
            background: transparent;
            border: 1px solid var(--admin-neon);
            color: var(--admin-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease-in-out;
        }

        .admin-btn:hover {
            background-color: var(--admin-neon);
            color: #000000;
            box-shadow: 0 0 15px rgba(255, 51, 102, 0.6);
            transform: translateY(-2px);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 14px;
        }

        .logout-btn {
            background: transparent;
            border: 1px solid var(--danger-neon);
            color: var(--danger-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: var(--danger-neon);
            color: var(--text-main);
        }

        @keyframes navShieldPulse {
            0% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
            50% { transform: scale(1.05); box-shadow: 0 0 18px rgba(255, 0, 85, 0.6); border-color: #ff0055; }
            100% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
        }

        @keyframes navNeonGlitch {
            0%, 95%, 100% { text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 0 15px rgba(0, 255, 204, 0.3); color: #fff; }
            96% { text-shadow: -2px -1px 0 #ff0055, 2px 1px 0 #00ffcc; color: #ff0055; }
            98% { text-shadow: 2px 1px 0 #ff0055, -2px -1px 0 #00ffcc; color: #00ffcc; }
        }

        /* =======================================================
           📊 DASHBOARD CONTROL CONTENT
           ======================================================= */
        .container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .dashboard-header h1 { color: var(--primary-neon); margin-bottom: 5px; }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .metric-card {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .metric-icon {
            font-size: 28px;
            color: var(--primary-neon);
        }

        .metric-info h4 { margin: 0; color: var(--text-muted); font-size: 13px; text-transform: uppercase; }
        .metric-info p { margin: 5px 0 0 0; font-size: 20px; font-weight: bold; }

        .section-title {
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
            margin-bottom: 20px;
            font-size: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .order-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .order-item {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid var(--primary-neon);
        }

        .empty-box {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px dashed var(--border-color);
            padding: 40px;
            text-align: center;
            border-radius: 8px;
            color: var(--text-muted);
        }

        .btn-lab {
            background: transparent;
            border: 1px solid var(--primary-neon);
            color: var(--primary-neon);
            padding: 8px 16px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .btn-lab:hover {
            background: var(--primary-neon);
            color: #000;
            box-shadow: 0 0 10px var(--primary-neon);
        }

        .back-btn {
            display: inline-block;
            margin-top: 50px;
            margin-bottom: 40px;
            color: var(--primary-neon);
            text-decoration: none;
            border: 1px solid var(--primary-neon);
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: bold;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .back-btn:hover {
            background: var(--primary-neon);
            color: #000;
            box-shadow: 0 0 15px var(--primary-neon);
        }
    </style>
</head>
<body>

    <canvas id="matrix-bg"></canvas>

    <header>
        <div class="navbar">
            <div class="navbar-brand-node">
                <div class="nav-animated-shield"></div>
                <span class="nav-brand-name">Shield Academy</span>
            </div>
            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/courses">Courses</a></li>
                <li><a href="/dashboard" class="active">My Dashboard</a></li>
                <li><a href="/about">About</a></li>
                <% if (user && user.role === 'admin') { %>
                    <li>
                        <a href="/admin/dashboard" class="admin-btn">
                            <i class="fa-solid fa-user-shield"></i> Admin Panel
                        </a>
                    </li>
                <% } %>
            </ul>
            <div class="user-profile">
                <span>Welcome, <b style="color: var(--primary-neon);"><%= user.name %></b></span>
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="dashboard-header">
            <h1>🖥️ Student Control Panel</h1>
            <p style="color: var(--text-muted);">Secure Infrastructure Node Active for: <b style="color: var(--primary-neon);"><%= user.name %></b></p>
        </div>

        <!-- 📊 CYBER METRICS PANEL -->
        <div class="metrics-grid">
            <div class="metric-card">
                <i class="fa-solid fa-graduation-cap metric-icon"></i>
                <div class="metric-info">
                    <h4>Enrolled Modules</h4>
                    <p><%= orders.length %></p>
                </div>
            </div>
            <div class="metric-card">
                <i class="fa-solid fa-shield-halved metric-icon"></i>
                <div class="metric-info">
                    <h4>Lab Server Status</h4>
                    <p style="color: #00ff00;">ONLINE</p>
                </div>
            </div>
            <div class="metric-card">
                <i class="fa-solid fa-terminal metric-icon"></i>
                <div class="metric-info">
                    <h4>CTF Rank Points</h4>
                    <p>740 PTS</p>
                </div>
            </div>
        </div>

        <!-- 📚 DYNAMIC COURSES EXTRACTION NODE -->
        <h3 class="section-title"><i class="fa-solid fa-book-bookmark" style="color: var(--primary-neon);"></i> Your Active Curriculum Assets</h3>
        
        <% if (orders.length > 0) { %>
            <div class="order-list">
                <% orders.forEach(function(order) { %>
                    <div class="order-item">
                        <div>
                            <h4 style="margin: 0 0 5px 0; font-size: 16px;"><%= order.courseName %></h4>
                            <small style="color: var(--text-muted);">Enrolled on: <%= new Date(order.purchaseDate).toLocaleDateString() %></small>
                        </div>
                        <a href="/course/<%= order.courseId %>" class="btn-lab"><i class="fa-solid fa-flask"></i> Launch Cyber Lab</a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-box">
                <i class="fa-solid fa-box-open" style="font-size: 40px; margin-bottom: 15px; display: block;"></i>
                You haven't enrolled in any cybersecurity courses yet. Go to Storefront to start learning!
            </div>
        <% } %>

        <div style="text-align: center;">
            <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Storefront</a>
        </div>
    </div>

<script>
const canvas = document.getElementById('matrix-bg');
const ctx = canvas.getContext('2d');
let particlesArray = [];
const numParticles = 85; 
const maxConnectDistance = 120;
let mouse = { x: null, y: null, radius: 160 };

window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mouseout', () => { mouse.x = null; mouse.y = null; });
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resizeCanvas(); window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.7; 
        this.vy = (Math.random() - 0.5) * 0.7;
        this.radius = Math.random() * 2.5 + 1;
    }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
        ctx.fillStyle = 'rgba(255, 0, 85, 0.7)'; ctx.fill();
    }
    update() {
        if (this.x < 0 || this.x > canvas.width) this.vx = -this.vx;
        if (this.y < 0 || this.y > canvas.height) this.vy = -this.vy;
        let dx = mouse.x - this.x; let dy = mouse.y - this.y; let dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < mouse.radius && mouse.x !== null) {
            this.x += (dx / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
            this.y += (dy / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
        }
        this.x += this.vx; this.y += this.vy;
    }
}
function initParticles() { for(let i=0; i<numParticles; i++) particlesArray.push(new Particle()); }
function connectNodes() {
    for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a + 1; b < particlesArray.length; b++) {
            let dx = particlesArray[a].x - particlesArray[b].x; let dy = particlesArray[a].y - particlesArray[b].y;
            let dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < maxConnectDistance) {
                ctx.strokeStyle = `rgba(255, 0, 85, ${(1 - (dist / maxConnectDistance)) * 0.18})`;
                ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(particlesArray[a].x, particlesArray[a].y); ctx.lineTo(particlesArray[b].x, particlesArray[b].y); ctx.stroke();
            }
        }
    }
}
function animateParticles() { ctx.clearRect(0, 0, canvas.width, canvas.height); for(let i=0; i<particlesArray.length; i++) { particlesArray[i].update(); particlesArray[i].draw(); } connectNodes(); requestAnimationFrame(animateParticles); }
initParticles(); animateParticles();
</script>
</body>
</html>