<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Admin Control Console</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        #matrix-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: -1; 
            pointer-events: none;
}
        :root {
            --bg-main: #070a13;
            --bg-card: #0f1424;
            --neon-admin: #ff3366;
            --neon-cyan: #00ffcc;
            --text-white: #ffffff;
            --text-grey: #9ca3af;
            --border-line: #1e293b;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-white);
            margin: 0;
            padding: 0;
        }

        header {
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-line);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-node {
            font-size: 20px;
            font-weight: bold;
            color: var(--neon-admin);
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .exit-link {
            color: var(--text-grey);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }

        .exit-link:hover {
            color: var(--neon-cyan);
        }

        main {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .metric-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-line);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .metric-info h3 {
            margin: 0;
            font-size: 14px;
            color: var(--text-grey);
            text-transform: uppercase;
        }

        .metric-info p {
            margin: 5px 0 0 0;
            font-size: 28px;
            font-weight: bold;
            color: var(--neon-cyan);
        }

        .metric-icon {
            font-size: 32px;
            color: var(--neon-admin);
            opacity: 0.8;
        }

        .data-section {
            background-color: var(--bg-card);
            border: 1px solid var(--border-line);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 40px;
        }

        .data-section h2 {
            margin-top: 0;
            font-size: 18px;
            border-left: 4px solid var(--neon-admin);
            padding-left: 10px;
            color: var(--text-white);
            margin-bottom: 20px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #141b32;
            color: var(--neon-cyan);
            padding: 12px 15px;
            font-weight: 600;
            border-bottom: 2px solid var(--border-line);
        }

        td {
            padding: 12px 15px;
            border-bottom: 1px solid var(--border-line);
            color: #e2e8f0;
        }

        tr:hover td {
            background-color: #161f38;
        }

        .role-badge {
            background-color: rgba(0, 255, 204, 0.1);
            color: var(--neon-cyan);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .role-badge.admin {
            background-color: rgba(255, 51, 102, 0.1);
            color: var(--neon-admin);
        }
    </style>
</head>
<body>

    <canvas id="matrix-bg"></canvas>
    <header>
        <div class="brand-node"><i class="fa-solid fa-terminal"></i> SHIELD PLATFORM AUDIT MATRIX</div>
        <div>
            <span style="margin-right: 20px;">Operator: <b style="color: var(--neon-cyan);"><%= user.name %></b></span>
            <a href="/" class="exit-link"><i class="fa-solid fa-arrow-left"></i> Core Storefront</a>
        </div>
    </header>

    <main>
        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-info">
                    <h3>Total Node Profiles</h3>
                    <p><%= stats.users %></p>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="metric-card">
                <div class="metric-info">
                    <h3>Total Enrolled Orders</h3>
                    <p><%= stats.orders %></p>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-cart-shopping"></i></div>
            </div>
        </div>

        <div class="data-section">
            <h2><i class="fa-solid fa-id-card"></i> Registered Platform User Profiles</h2>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>User ID Token</th>
                            <th>Name</th>
                            <th>Email Address Node</th>
                            <th>Privilege Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(u) { %>
                            <tr>
                                <td style="font-family: monospace; color: var(--text-grey);"><%= u._id %></td>
                                <td><b><%= u.name %></b></td>
                                <td><%= u.email %></td>
                                <td>
                                    <span class="role-badge <%= u.role === 'admin' ? 'admin' : '' %>">
                                        <%= u.role %>
                                    </span>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="data-section">
            <h2><i class="fa-solid fa-bolt"></i> Live Course Purchase Activity Tracker</h2>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Transaction Hash ID</th>
                            <th>User Email Node</th>
                            <th>Course ID Field</th>
                            <th>Purchased Course Name</th>
                            <th>Verification Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(orders.length === 0) { %>
                            <tr>
                                <td colspan="5" style="text-align: center; color: var(--text-grey);">No active transactional orders routed to this pipeline yet.</td>
                            </tr>
                        <% } else { %>
                            <% orders.forEach(function(order) { %>
                                <tr>
                                    <td style="font-family: monospace; color: var(--text-grey);"><%= order._id %></td>
                                    <td><b style="color: var(--neon-cyan);"><%= order.userEmail %></b></td>
                                    <td><span style="font-family: monospace;"><%= order.courseId %></span></td>
                                    <td><b><%= order.courseName %></b></td>
                                    <td><%= new Date(order.purchaseDate).toLocaleString() %></td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
<script>
// 🌌 GLOBAL RED BACKGROUND PARTICLES ENGINE
const canvas = document.getElementById('matrix-bg');
const ctx = canvas.getContext('2d');
let particlesArray = [];
const numParticles = 85; 
const maxConnectDistance = 120;
let mouse = { x: null, y: null, radius: 160 };

window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mouseout', () => { mouse.x = null; mouse.y = null; });
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resizeCanvas(); window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.7; 
        this.vy = (Math.random() - 0.5) * 0.7;
        this.radius = Math.random() * 2.5 + 1;
    }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
        ctx.fillStyle = 'rgba(255, 0, 85, 0.7)'; ctx.fill();
    }
    update() {
        if (this.x < 0 || this.x > canvas.width) this.vx = -this.vx;
        if (this.y < 0 || this.y > canvas.height) this.vy = -this.vy;
        let dx = mouse.x - this.x; let dy = mouse.y - this.y; let dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < mouse.radius && mouse.x !== null) {
            this.x += (dx / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
            this.y += (dy / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
        }
        this.x += this.vx; this.y += this.vy;
    }
}
function initParticles() { for(let i=0; i<numParticles; i++) particlesArray.push(new Particle()); }
function connectNodes() {
    for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a + 1; b < particlesArray.length; b++) {
            let dx = particlesArray[a].x - particlesArray[b].x; let dy = particlesArray[a].y - particlesArray[b].y;
            let dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < maxConnectDistance) {
                ctx.strokeStyle = `rgba(255, 0, 85, ${(1 - (dist / maxConnectDistance)) * 0.18})`;
                ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(particlesArray[a].x, particlesArray[a].y); ctx.lineTo(particlesArray[b].x, particlesArray[b].y); ctx.stroke();
            }
        }
    }
}
function animateParticles() { ctx.clearRect(0, 0, canvas.width, canvas.height); for(let i=0; i<particlesArray.length; i++) { particlesArray[i].update(); particlesArray[i].draw(); } connectNodes(); requestAnimationFrame(animateParticles); }
initParticles(); animateParticles();
</script>
</body>
</html>