<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Shield Academy Matrix</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        #matrix-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            z-index: -1; 
            pointer-events: none;
        }
        :root {
            --bg-color: #060913;
            --card-bg: rgba(17, 24, 39, 0.75);
            --primary-neon: #00ffcc;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --border-color: rgba(31, 41, 55, 0.7);
            --danger-neon: #ff3333;
            --admin-neon: #ff3366;
            --accent-glow: rgba(0, 255, 204, 0.15);
        }

        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: rgba(17, 24, 39, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* =======================================================
           🛡️ BRAND NAVBAR LOGO & NEON GLITCH ENGINE
           ======================================================= */
        .navbar-brand-node {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: default;
            user-select: none;
            text-decoration: none;
        }

        .nav-animated-shield {
            position: relative;
            width: 35px;
            height: 38px;
            background: transparent;
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            border: 1.5px solid #00ffcc;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
            animation: navShieldPulse 3s infinite ease-in-out;
        }

        .nav-animated-shield::before {
            content: "🛡️";
            font-size: 16px;
        }

        .nav-brand-name {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.6);
            margin: 0;
            animation: navNeonGlitch 4s infinite alternate;
        }

        @keyframes navShieldPulse {
            0% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
            50% { transform: scale(1.05); box-shadow: 0 0 18px rgba(255, 0, 85, 0.6); border-color: #ff0055; }
            100% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
        }

        @keyframes navNeonGlitch {
            0%, 95%, 100% { text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 0 15px rgba(0, 255, 204, 0.3); color: #fff; }
            96% { text-shadow: -2px -1px 0 #ff0055, 2px 1px 0 #00ffcc; color: #ff0055; }
            98% { text-shadow: 2px 1px 0 #ff0055, -2px -1px 0 #00ffcc; color: #00ffcc; }
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            margin: 0;
            padding: 0;
            align-items: center;
        }

        .nav-menu a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-menu a:hover, .nav-menu a.active {
            color: var(--primary-neon);
        }

        .admin-btn {
            background: transparent;
            border: 1px solid var(--admin-neon);
            color: var(--admin-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease-in-out;
        }

        .admin-btn:hover {
            background-color: var(--admin-neon);
            color: #000000;
            box-shadow: 0 0 15px rgba(255, 51, 102, 0.6);
            transform: translateY(-2px);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 14px;
        }

        .logout-btn {
            background: transparent;
            border: 1px solid var(--danger-neon);
            color: var(--danger-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: var(--danger-neon);
            color: var(--text-main);
        }

        main {
            max-width: 1200px;
            margin: 50px auto;
            padding: 0 20px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }

        .about-hero {
            position: relative;
            background: linear-gradient(135px, rgba(17, 24, 39, 0.8) 0%, rgba(7, 10, 19, 0.9) 100%);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 60px 40px;
            text-align: center;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            margin-bottom: 60px;
        }

        .about-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 60%);
            pointer-events: none;
        }

        .about-hero h1 {
            font-size: 42px;
            margin: 0 0 15px 0;
            background: linear-gradient(to right, #ffffff, var(--primary-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -1px;
        }

        .about-hero p {
            color: var(--text-muted);
            font-size: 18px;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .showcase-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
            margin-bottom: 60px;
        }

        @media (max-width: 768px) {
            .showcase-grid { grid-template-columns: 1fr; }
        }

        .showcase-image-wrapper {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            box-shadow: 0 15px 30px rgba(0,0,0,0.4);
        }

        .showcase-image {
            width: 100%;
            height: 350px;
            object-fit: cover;
            display: block;
            transition: transform 0.5s ease;
        }

        .showcase-image-wrapper:hover .showcase-image {
            transform: scale(1.05);
        }

        .showcase-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(11,15,25,0.9) 10%, transparent 100%);
            display: flex;
            align-items: flex-end;
            padding: 30px;
        }

        .showcase-text h2 {
            font-size: 24px;
            margin: 0 0 10px 0;
            color: var(--primary-neon);
        }

        .showcase-text p {
            margin: 0;
            color: #e2e8f0;
            font-size: 15px;
            line-height: 1.5;
        }

        .features-matrix {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .feature-node {
            background-color: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .feature-node:hover {
            transform: translateY(-5px);
            border-color: var(--primary-neon);
            box-shadow: 0 10px 25px rgba(0, 255, 204, 0.1);
        }

        .icon-box {
            font-size: 40px;
            color: var(--primary-neon);
            margin-bottom: 20px;
        }

        .feature-node h3 {
            margin: 0 0 10px 0;
            font-size: 20px;
        }

        .feature-node p {
            margin: 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
        }

        footer {
            background-color: #111827;
            border-top: 1px solid var(--border-color);
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 60px;
        }
    </style>
</head>
<body>

    <canvas id="matrix-bg"></canvas>

    <header>
        <div class="navbar">
            
            <div class="navbar-brand-node">
                <div class="nav-animated-shield"></div>
                <span class="nav-brand-name">Shield Academy</span>
            </div>

            <ul class="nav-menu">
                <li><a href="/">Home</a></li>
                <li><a href="/courses">Courses</a></li>
                <li><a href="/dashboard">My Dashboard</a></li>
                <li><a href="/about" class="active">About</a></li>
                
                <% if (user && user.role === 'admin') { %>
                    <li>
                        <a href="/admin/dashboard" class="admin-btn">
                            <i class="fa-solid fa-user-shield"></i> Admin Panel
                        </a>
                    </li>
                <% } %>
            </ul>
            <div class="user-profile">
                <span>Welcome, <b style="color: var(--primary-neon);"><%= user.name %></b></span>
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </div>
    </header>

    <main>
        <div class="about-hero">
            <h1>DECODING CYBER LAB INFRASTRUCTURE</h1>
            <p>Shield Academy provides an advanced ecosystem for next-generation security engineers. We specialize in dynamic automation setups, deep-penetration testing arrays, and threat analytics monitoring nodes.</p>
        </div>

        <div class="showcase-grid">
            <div class="showcase-image-wrapper">
                <img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=600&q=80" class="showcase-image" alt="Cyber security lab architecture">
                <div class="showcase-overlay">
                    <div class="showcase-text">
                        <h2>Advanced Research Cell</h2>
                        <p>Our virtual sandbox terminals are configured to deploy deep analysis framework execution instantly with zero asset disruption.</p>
                    </div>
                </div>
            </div>

            <div class="showcase-image-wrapper">
                <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=80" class="showcase-image" alt="Server clusters computing hardware">
                <div class="showcase-overlay">
                    <div class="showcase-text">
                        <h2>Infrastructure Defense</h2>
                        <p>We train engineers to architect impenetrable security matrices across hybrid cloud systems using strict hardening protocols.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="features-matrix">
            <div class="feature-node">
                <div class="icon-box"><i class="fa-solid fa-shield-halved"></i></div>
                <h3>Elite Training Core</h3>
                <p>Curated learning materials engineered precisely from scratch to help navigate active digital threats effortlessly.</p>
            </div>

            <div class="feature-node">
                <div class="icon-box"><i class="fa-solid fa-network-wired"></i></div>
                <h3>Dynamic Webhooks</h3>
                <p>Integrated pipeline protocols sync your enrollment status safely using automated transactional dispatch pipelines.</p>
            </div>

            <div class="feature-node">
                <div class="icon-box"><i class="fa-solid fa-user-gear"></i></div>
                <h3>Secured Console Nodes</h3>
                <p>Strict structural backend access filters guarantee that data analytics parameters remain fully optimized and authorized.</p>
            </div>
        </div>
    </main>

    <footer>
        &copy; 2026 Shield Academy Enterprise. Zero-Cost Infrastructure Integration.
    </footer>

<script>
const canvas = document.getElementById('matrix-bg');
const ctx = canvas.getContext('2d');
let particlesArray = [];
const numParticles = 85; 
const maxConnectDistance = 120;
let mouse = { x: null, y: null, radius: 160 };

window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mouseout', () => { mouse.x = null; mouse.y = null; });
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resizeCanvas(); window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.7; 
        this.vy = (Math.random() - 0.5) * 0.7;
        this.radius = Math.random() * 2.5 + 1;
    }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
        ctx.fillStyle = 'rgba(255, 0, 85, 0.7)'; ctx.fill();
    }
    update() {
        if (this.x < 0 || this.x > canvas.width) this.vx = -this.vx;
        if (this.y < 0 || this.y > canvas.height) this.vy = -this.vy;
        let dx = mouse.x - this.x; let dy = mouse.y - this.y; let dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < mouse.radius && mouse.x !== null) {
            this.x += (dx / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
            this.y += (dy / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
        }
        this.x += this.vx; this.y += this.vy;
    }
}
function initParticles() { for(let i=0; i<numParticles; i++) particlesArray.push(new Particle()); }
function connectNodes() {
    for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a + 1; b < particlesArray.length; b++) {
            let dx = particlesArray[a].x - particlesArray[b].x; let dy = particlesArray[a].y - particlesArray[b].y;
            let dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < maxConnectDistance) {
                ctx.strokeStyle = `rgba(255, 0, 85, ${(1 - (dist / maxConnectDistance)) * 0.18})`;
                ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(particlesArray[a].x, particlesArray[a].y); ctx.lineTo(particlesArray[b].x, particlesArray[b].y); ctx.stroke();
            }
        }
    }
}
function animateParticles() { ctx.clearRect(0, 0, canvas.width, canvas.height); for(let i=0; i<particlesArray.length; i++) { particlesArray[i].update(); particlesArray[i].draw(); } connectNodes(); requestAnimationFrame(animateParticles); }
initParticles(); animateParticles();
</script>
</body>
</html>