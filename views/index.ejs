<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shield Academy - Professional Cyber Store</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #060913; 
            --card-bg: rgba(17, 24, 39, 0.75); 
            --primary-neon: #00ffcc; 
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            --border-color: rgba(31, 41, 55, 0.7);
            --danger-neon: #ff3333;
            --admin-neon: #ff3366; 
        }

        #matrix-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1; 
            pointer-events: none;
        }

        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: rgba(17, 24, 39, 0.9);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            max-width: 1200px;
            margin: 0 auto;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* =======================================================
           🛡️ BRAND NAVBAR LOGO & NEON GLITCH ENGINE
           ======================================================= */
        .navbar-brand-node {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: default;
            user-select: none;
            text-decoration: none;
        }

        .nav-animated-shield {
            position: relative;
            width: 35px;
            height: 38px;
            background: transparent;
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            border: 1.5px solid #00ffcc;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
            animation: navShieldPulse 3s infinite ease-in-out;
        }

        .nav-animated-shield::before {
            content: "🛡️";
            font-size: 16px;
        }

        .nav-brand-name {
            font-size: 20px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.6);
            margin: 0;
            animation: navNeonGlitch 4s infinite alternate;
        }

        @keyframes navShieldPulse {
            0% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
            50% { transform: scale(1.05); box-shadow: 0 0 18px rgba(255, 0, 85, 0.6); border-color: #ff0055; }
            100% { transform: scale(1); box-shadow: 0 0 10px rgba(0, 255, 204, 0.4); border-color: #00ffcc; }
        }

        @keyframes navNeonGlitch {
            0%, 95%, 100% { text-shadow: 0 0 8px rgba(0, 255, 204, 0.6), 0 0 15px rgba(0, 255, 204, 0.3); color: #fff; }
            96% { text-shadow: -2px -1px 0 #ff0055, 2px 1px 0 #00ffcc; color: #ff0055; }
            98% { text-shadow: 2px 1px 0 #ff0055, -2px -1px 0 #00ffcc; color: #00ffcc; }
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
            margin: 0;
            padding: 0;
            align-items: center;
        }

        .nav-menu a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-menu a:hover, .nav-menu a.active {
            color: var(--primary-neon);
        }

        .admin-btn {
            background: transparent;
            border: 1px solid var(--admin-neon);
            color: var(--admin-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease-in-out;
        }

        .admin-btn:hover {
            background-color: var(--admin-neon);
            color: #000000;
            box-shadow: 0 0 15px rgba(255, 51, 102, 0.6);
            transform: translateY(-2px);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 14px;
        }

        .logout-btn {
            background: transparent;
            border: 1px solid var(--danger-neon);
            color: var(--danger-neon);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background: var(--danger-neon);
            color: var(--text-main);
        }

        main {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }

        .hero-section {
            text-align: center;
            margin-bottom: 40px;
        }

        .hero-section h2 {
            font-size: 42px;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #fff, var(--primary-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-section p {
            color: var(--text-muted);
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

        .metrics-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 50px;
        }

        .metric-node {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            border-bottom: 3px solid var(--primary-neon);
        }

        .metric-node i {
            font-size: 28px;
            color: var(--primary-neon);
            margin-bottom: 10px;
        }

        .metric-node h4 {
            margin: 0;
            font-size: 13px;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .metric-node p {
            margin: 8px 0 0 0;
            font-size: 24px;
            font-weight: bold;
            font-family: monospace;
        }

        .scanner-section {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px dashed var(--primary-neon);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 50px;
        }

        .scanner-section h3 {
            margin-top: 0;
            color: var(--primary-neon);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .scanner-layout {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .scan-btn {
            background: transparent;
            border: 1px solid var(--primary-neon);
            color: var(--primary-neon);
            padding: 0 25px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 6px;
            text-transform: uppercase;
            transition: all 0.2s;
        }

        .scan-btn:hover {
            background: var(--primary-neon);
            color: #000;
            box-shadow: 0 0 15px var(--primary-neon);
        }

        .terminal-logs {
            background: #050811;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 15px;
            margin-top: 20px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            color: #00ff00;
            min-height: 80px;
            max-height: 200px;
            overflow-y: auto;
            display: none;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            width: 100%;
            margin-bottom: 60px;
        }

        .card {
            background-color: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            transition: transform 0.2s, border-color 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-neon);
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.2);
        }

        .card-header h3 {
            margin: 0 0 10px 0;
            font-size: 20px;
            color: var(--text-main);
        }

        .card-header p {
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 20px;
        }
        .card-img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 15px;
            border: 1px solid var(--border-color);
        }

        .price-tag {
            font-size: 22px;
            font-weight: bold;
            color: var(--primary-neon);
            margin-bottom: 15px;
        }

        .checkout-btn {
            width: 100%;
            padding: 14px;
            background-color: var(--primary-neon);
            color: #000;
            border: none;
            font-weight: bold;
            font-size: 15px;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .checkout-btn:hover {
            background-color: #00ccaa;
        }

        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(5, 8, 17, 0.85);
            backdrop-filter: blur(8px);
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-backdrop.active {
            opacity: 1;
            pointer-events: auto;
        }

        .payment-modal {
            background: #111827;
            border: 2px solid var(--primary-neon);
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            padding: 30px;
            box-shadow: 0 0 30px rgba(0, 255, 204, 0.2);
            position: relative;
            transform: scale(0.9);
            transition: transform 0.3s ease;
        }

        .modal-backdrop.active .payment-modal {
            transform: scale(1);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
        }

        .modal-close:hover {
            color: var(--danger-neon);
        }

        .gateway-title {
            font-size: 18px;
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid #1f2937;
            padding-bottom: 10px;
        }

        .modal-input-group {
            margin-bottom: 15px;
        }

        .modal-input-group label {
            display: block;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .modal-input-group input {
            width: 100%;
            padding: 12px;
            background: #0b0f19;
            border: 1px solid #1f2937;
            border-radius: 6px;
            color: #ffffff;
            font-size: 14px;
            box-sizing: border-box;
        }

        .modal-input-group input:focus {
            border-color: var(--primary-neon);
            outline: none;
        }

        .pay-submit-btn {
            width: 100%;
            padding: 14px;
            background: var(--primary-neon);
            color: #000;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            font-size: 15px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .pay-submit-btn:hover {
            background: #00ccaa;
            box-shadow: 0 0 15px var(--primary-neon);
        }

        .pay-submit-btn:disabled {
            background: #1f2937;
            color: var(--text-muted);
            cursor: not-allowed;
            box-shadow: none;
        }

        .faq-section {
            max-width: 800px;
            margin: 0 auto 40px auto;
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .faq-section h3 {
            text-align: center;
            color: var(--primary-neon);
            font-size: 24px;
            margin-top: 0;
            margin-bottom: 30px;
        }

        .accordion-item {
            background: rgba(6, 9, 19, 0.6);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            margin-bottom: 12px;
            overflow: hidden;
        }

        .accordion-header {
            padding: 18px 20px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            user-select: none;
        }

        .accordion-header:hover {
            background: #161f32;
            color: var(--primary-neon);
        }

        .accordion-content {
            padding: 0 20px;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease, padding 0.3s ease;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            border-top: 1px solid transparent;
        }

        .accordion-item.active .accordion-content {
            padding: 18px 20px;
            max-height: 200px;
            border-top: 1px solid var(--border-color);
        }

        footer {
            background-color: #111827;
            border-top: 1px solid var(--border-color);
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--text-muted);
            margin-top: auto;
        }
    </style>
</head>
<body>

    <canvas id="matrix-bg"></canvas>

    <header>
        <div class="navbar">
            
            <!-- INSTANTIATING ANIMATED NAVBAR BRAND ENGINE -->
            <div class="navbar-brand-node">
                <div class="nav-animated-shield"></div>
                <span class="nav-brand-name">Shield Academy</span>
            </div>

            <ul class="nav-menu">
                <li><a href="/" class="active">Home</a></li>
                <li><a href="/courses">Courses</a></li>
                <li><a href="/dashboard">My Dashboard</a></li>
                <li><a href="/about">About</a></li>
                
                <% if (user && user.role === 'admin') { %>
                    <li>
                        <a href="/admin/dashboard" class="admin-btn">
                            <i class="fa-solid fa-user-shield"></i> Admin Panel
                        </a>
                    </li>
                <% } %>
            </ul>
            <div class="user-profile">
                <span>Welcome, <b style="color: var(--primary-neon);"><%= user.name %></b></span>
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </div>
    </header>

    <main>
        <div class="hero-section">
            <h2>Advance Your Cybersecurity Career</h2>
            <p>Get access to industry-grade training bundles. Secured verification tracking active.</p>
        </div>

        <div class="metrics-container">
            <div class="metric-node">
                <i class="fa-solid fa-user-ninja"></i>
                <h4>Active Trainee Nodes</h4>
                <p id="counter-trainees">14,820</p>
            </div>
            <div class="metric-node">
                <i class="fa-solid fa-shield-virus"></i>
                <h4>Threats Neutralized</h4>
                <p id="counter-attacks">843,291</p>
            </div>
            <div class="metric-node">
                <i class="fa-solid fa-server"></i>
                <h4>Virtual Lab Sandboxes</h4>
                <p>100% ONLINE</p>
            </div>
        </div>

        <div class="scanner-section">
            <h3><i class="fa-solid fa-terminal"></i> Sandbox Vulnerability Threat Scanner</h3>
            <p style="color: var(--text-muted); font-size: 14px; margin: 5px 0 0 0;">Enter a network target node or hostname to execute a simulation exploit scan.</p>
            <div class="scanner-layout">
                <input type="text" id="scan-target" placeholder="e.g., 192.168.1.45 or securenode.local" value="192.168.4.102">
                <button class="scan-btn" onclick="executeMockScan()">Launch Exploits</button>
            </div>
            <div class="terminal-logs" id="terminal-screen"></div>
        </div>

        <h3 style="color: var(--primary-neon); border-left: 4px solid var(--primary-neon); padding-left: 10px; margin-bottom: 25px;">Available Defense Modules</h3>
        <div class="grid">
            <% courses.forEach(function(course) { %>
                <div class="card">
                    <div class="card-header">
                        <img src="<%= course.image %>" class="card-img" alt="<%= course.name %>">
                        <h3><%= course.name %></h3>
                        <p><%= course.desc %></p>
                    </div>
                    <div>
                        <div class="price-tag">Rs. <%= course.price %></div>
                        <button class="checkout-btn" onclick="openPaymentGateway('<%= course.id %>', '<%= course.name %>', '<%= course.price %>')">Instant Checkout</button>
                        <div class="status-box" id="status-<%= course.id %>"></div>
                    </div>
                </div>
            <% }); %>
        </div>

        <div class="faq-section">
            <h3><i class="fa-regular fa-comments"></i> Central FAQ Hub</h3>
            <div class="accordion-item">
                <div class="accordion-header" onclick="toggleAccordion(this)">
                    How long do I get access to the laboratory bundles? <i class="fa-solid fa-plus"></i>
                </div>
                <div class="accordion-content">
                    Once an enrollment transaction hash registers on our MongoDB infrastructure node, you receive lifetime access parameters including all upcoming updates.
                </div>
            </div>
            <div class="accordion-item">
                <div class="accordion-header" onclick="toggleAccordion(this)">
                    Do I need separate simulation software configurations? <i class="fa-solid fa-plus"></i>
                </div>
                <div class="accordion-content">
                    Negative. Shield Academy architectures run completely virtualized inside cloud sandbox systems, accessible via any standardized browser console.
                </div>
            </div>
        </div>
    </main>

    <div class="modal-backdrop" id="gateway-modal">
        <div class="payment-modal">
            <button class="modal-close" onclick="closePaymentGateway()"><i class="fa-solid fa-xmark"></i></button>
            <div class="gateway-title" id="modal-title"><i class="fa-solid fa-vault"></i> Shield Secure Gateway</div>
            
            <div class="modal-input-group">
                <label>Cardholder Name</label>
                <input type="text" id="card-name" value="<%= user.name %>">
            </div>
            <div class="modal-input-group">
                <label>Credit/Debit Card Number</label>
                <input type="text" id="card-number" placeholder="4532 •••• •••• 8824" maxlength="19">
            </div>
            <div style="display: flex; gap: 15px;">
                <div class="modal-input-group" style="flex: 1;">
                    <label>Expiration</label>
                    <input type="text" id="card-expiry" placeholder="MM/YY" maxlength="5">
                </div>
                <div class="modal-input-group" style="flex: 1;">
                    <label>Security Code (CVV)</label>
                    <input type="password" id="card-cvv" placeholder="•••" maxlength="3">
                </div>
            </div>

            <button class="pay-submit-btn" id="pay-button" onclick="processSecurePayment()">
                <i class="fa-solid fa-lock"></i> Authorize Encrypted Pay
            </button>
            <div id="modal-status" style="margin-top: 15px; text-align: center; font-size: 13px; font-weight: 500;"></div>
        </div>
    </div>

    <footer>
        &copy; 2026 Shield Academy Enterprise. Zero-Cost Infrastructure Integration.
    </footer>

<script>
let activeCourseId = '';
let activeCourseName = '';
let loggedInUserEmail = '<%= user.email %>';

const canvas = document.getElementById('matrix-bg');
const ctx = canvas.getContext('2d');
let particlesArray = [];
const numParticles = 85; 
const maxConnectDistance = 120;
let mouse = { x: null, y: null, radius: 160 };

window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
window.addEventListener('mouseout', () => { mouse.x = null; mouse.y = null; });
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resizeCanvas(); window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.vx = (Math.random() - 0.5) * 0.7; 
        this.vy = (Math.random() - 0.5) * 0.7;
        this.radius = Math.random() * 2.5 + 1;
    }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2, false);
        ctx.fillStyle = 'rgba(255, 0, 85, 0.7)'; ctx.fill();
    }
    update() {
        if (this.x < 0 || this.x > canvas.width) this.vx = -this.vx;
        if (this.y < 0 || this.y > canvas.height) this.vy = -this.vy;
        let dx = mouse.x - this.x; let dy = mouse.y - this.y; let dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < mouse.radius && mouse.x !== null) {
            this.x += (dx / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
            this.y += (dy / dist) * ((mouse.radius - dist) / mouse.radius) * 1.5;
        }
        this.x += this.vx; this.y += this.vy;
    }
}
function initParticles() { for(let i=0; i<numParticles; i++) particlesArray.push(new Particle()); }
function connectNodes() {
    for (let a = 0; a < particlesArray.length; a++) {
        for (let b = a + 1; b < particlesArray.length; b++) {
            let dx = particlesArray[a].x - particlesArray[b].x; let dy = particlesArray[a].y - particlesArray[b].y;
            let dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < maxConnectDistance) {
                ctx.strokeStyle = `rgba(255, 0, 85, ${(1 - (dist / maxConnectDistance)) * 0.18})`;
                ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(particlesArray[a].x, particlesArray[a].y); ctx.lineTo(particlesArray[b].x, particlesArray[b].y); ctx.stroke();
            }
        }
    }
}
function animateParticles() { ctx.clearRect(0, 0, canvas.width, canvas.height); for(let i=0; i<particlesArray.length; i++) { particlesArray[i].update(); particlesArray[i].draw(); } connectNodes(); requestAnimationFrame(animateParticles); }
initParticles(); animateParticles();

function openPaymentGateway(courseId, courseName, price) {
    activeCourseId = courseId;
    activeCourseName = courseName;
    
    document.getElementById('modal-title').innerHTML = `<i class="fa-solid fa-shield-halved"></i> Secure Pay: Rs. ${price}`;
    document.getElementById('modal-status').innerText = '';
    document.getElementById('card-number').value = '';
    document.getElementById('card-expiry').value = '';
    document.getElementById('card-cvv').value = '';
    document.getElementById('pay-button').disabled = false;
    
    document.getElementById('gateway-modal').classList.add('active');
}

function closePaymentGateway() {
    document.getElementById('gateway-modal').classList.remove('active');
}

async function processSecurePayment() {
    const cardNum = document.getElementById('card-number').value;
    const cardExp = document.getElementById('card-expiry').value;
    const cardCvv = document.getElementById('card-cvv').value;
    const modalStatus = document.getElementById('modal-status');
    const payBtn = document.getElementById('pay-button');
    const globalStatus = document.getElementById(`status-${activeCourseId}`);

    if(!cardNum || !cardExp || !cardCvv) {
        modalStatus.innerText = "🚨 Error: Missing encryption tokens.";
        modalStatus.style.color = "var(--danger-neon)";
        return;
    }

    payBtn.disabled = true;
    modalStatus.innerText = "🔐 Securing SSH Tunnel Node...";
    modalStatus.style.color = "var(--primary-neon)";

    setTimeout(() => {
        modalStatus.innerText = "💱 Broadcasting Transaction Authorization Block...";
        modalStatus.style.color = "#ffaa00";
    }, 1200);

    setTimeout(async () => {
        try {
            let currentStatus = (cardCvv === '123') ? 'SUCCESS' : 'DECLINED';

            const response = await fetch('/api/checkout-mock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    name: document.getElementById('card-name').value, 
                    email: loggedInUserEmail, 
                    courseId: activeCourseId,
                    paymentStatus: currentStatus 
                })
            });

            const data = await response.json();
            if(data.success) {
                modalStatus.innerText = "✓ Access Key Verified! Redirecting...";
                modalStatus.style.color = "var(--primary-neon)";
                
                globalStatus.innerText = "🎉 Enrolled via Secured Payment Node!";
                globalStatus.style.color = "var(--primary-neon)";
                
                setTimeout(closePaymentGateway, 1500);
            } else {
                modalStatus.innerText = "❌ Security Alert: Card verification declined or failed.";
                modalStatus.style.color = "var(--danger-neon)";
                payBtn.disabled = false;
            }
        } catch (err) {
            modalStatus.innerText = "❌ Global payment grid routing timeout.";
            modalStatus.style.color = "var(--danger-neon)";
            payBtn.disabled = false;
        }
    }, 2800);
}

setInterval(() => {
    const attackNode = document.getElementById('counter-attacks');
    let currentAttacks = parseInt(attackNode.innerText.replace(/,/g, ''));
    currentAttacks += Math.floor(Math.random() * 4) + 1;
    attackNode.innerText = currentAttacks.toLocaleString();
}, 2500);

function toggleAccordion(el) {
    const item = el.parentElement; const icon = el.querySelector('i'); item.classList.toggle('active');
    icon.className = item.classList.contains('active') ? "fa-solid fa-minus" : "fa-solid fa-plus";
}

function executeMockScan() {
    const target = document.getElementById('scan-target').value;
    const terminal = document.getElementById('terminal-screen');
    if(!target) return alert("Specify asset target.");
    terminal.style.display = "block"; terminal.innerHTML = "";
    const lines = [
        `[INIT] Target node localized: ${target}...`,
        `[SCAN] Auditing SSL handshakes and network routing nodes...`,
        `[WARN] Port 443 active. Attempting buffer bypass vector sequence...`,
        `[SUCCESS] Injection node mapped successfully. Exploit payload executed. Status: SECURE.`
    ];
    let i = 0;
    function print() { if(i < lines.length) { terminal.innerHTML += lines[i] + "<br>"; i++; setTimeout(print, 1000); } }
    print();
}
